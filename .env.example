# ==============================================================================
# TruthLens - Environment Configuration Template
# Copy this file to '.env' and populate your keys. Never commit '.env' to git!
# ==============================================================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
# If left empty, TruthLens will operate in offline mock demonstration mode.
GEMINI_API_KEY=your_gemini_api_key_here


# Model selection - central configuration (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Server Network Configuration (Mandatory Port 8765)
PORT=8765
HOST=127.0.0.1

# Flask Security Key
SECRET_KEY=truthlens-local-secret-key-change-for-production

# Storage path for SQLite database
DATABASE_PATH=storage/truthlens.db

# Article Extraction & API Request Limits
REQUEST_TIMEOUT=15
MAX_ARTICLE_CHARS=25000

# Factual Evidence Verification (true/false)
# Enables open-source fact-checking queries via Wikipedia API / DuckDuckGo
ENABLE_FACT_CHECK_SEARCH=true
